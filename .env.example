# Why (Voice) AI Agents Fail — environment variables
#
# Copy this file to .env and fill in your API keys.
# The scripts will auto-load .env from the repo root.
# Never commit .env.

# ── Required ──────────────────────────────────────────────────────────────

# Deepgram — speech-to-text in scripts 01, 03
# https://deepgram.com (free tier covers the entire series)
DEEPGRAM_API_KEY=your-deepgram-api-key-here

# Rime — text-to-speech in all four scripts
# https://rime.ai (free tier covers the entire series)
RIME_API_KEY=your-rime-api-key-here

# Nebius Token Factory — small/fast LLM for classifiers and the agent loop in
# scripts 01, 02, 03, 04. OpenAI-compatible API; we use the OpenAI SDK with
# Nebius's base URL.
# https://nebius.com/services/token-factory (free credits cover the series)
NEBIUS_API_KEY=your-nebius-api-key-here

# ── Optional ──────────────────────────────────────────────────────────────

# Override the default Nebius model. Any chat-completion model on Nebius works.
# Defaults to a small, sub-second `-fast` model — fine for all four scripts.
# Try Qwen3, MiniMax-M2.5, DeepSeek-R1, etc. via the dashboard:
#   https://nebius.com/services/token-factory
# NEBIUS_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# Override the Nebius base URL (US-central or EU regions, etc.)
# Defaults to https://api.tokenfactory.nebius.com/v1/
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Why (Voice) AI Agents Fail — environment variables
#
# Copy this file to .env and fill in your API keys.
# The scripts will auto-load .env from the repo root.

# Deepgram — used for speech-to-text in scripts 01, 03
# https://deepgram.com (free tier covers the entire series)
DEEPGRAM_API_KEY=

# Rime — used for text-to-speech in all four scripts
# https://rime.ai (free tier covers the entire series)
RIME_API_KEY=

# OpenAI — used for the small classifiers and agent loop in 01, 02, 03, 04
# https://platform.openai.com
OPENAI_API_KEY=
